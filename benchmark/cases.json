{
  "warmup": 1,
  "runs": 3,
  "timeout_s": 30,
  "sizes": [100, 1000, 5000, 25000, 50000, 100000, 200000],
  "quick_sizes": [100],
  "widths": ["narrow", "broad"],
  "exclude": [
    {
      "id": "users-broad-50k-identity",
      "tool": "yq",
      "why": "yq ~10× slower than the rest of the panel on this cell"
    },
    {
      "id": "users-broad-100k-slice-length",
      "tool": "yq",
      "why": "yq ~15× slower than the rest of the panel on this cell"
    },
    {
      "id": "users-broad-100k-first-id",
      "tool": "yq",
      "why": "yq ~10× slower than the rest of the panel on this cell"
    },
    {
      "id": "users-broad-100k-count",
      "tool": "yq",
      "why": "yq ~10× slower than the rest of the panel on this cell"
    },
    {
      "id": "users-broad-25k-identity",
      "tool": "yq",
      "why": "yq ~10× slower than the rest of the panel on this cell"
    },
    {
      "id": "users-broad-50k-slice-length",
      "tool": "yq",
      "why": "yq ~15× slower than the rest of the panel on this cell"
    },
    {
      "id": "users-broad-50k-count",
      "tool": "yq",
      "why": "yq ~10× slower than the rest of the panel on this cell"
    },
    {
      "id": "users-broad-50k-first-id",
      "tool": "yq",
      "why": "yq ~10× slower than the rest of the panel on this cell"
    },
    {
      "id": "users-broad-200k-count",
      "tool": "yq",
      "why": "yq ~10× slower than the rest of the panel on this cell"
    },
    {
      "id": "users-broad-200k-identity",
      "tool": "yq",
      "why": "yq ~10× slower than the rest of the panel on this cell"
    },
    {
      "id": "users-broad-200k-slice-length",
      "tool": "yq",
      "why": "yq ~15× slower than the rest of the panel on this cell"
    }
  ],
  "disagree": [
    {
      "id": "users-broad-100-identity",
      "tool": "gojq",
      "why": "gojq writes object keys in sorted order; compact bytes differ, JSON values match"
    },
    {
      "id": "users-broad-1k-identity",
      "tool": "gojq",
      "why": "gojq writes object keys in sorted order; compact bytes differ, JSON values match"
    },
    {
      "id": "users-broad-5k-identity",
      "tool": "gojq",
      "why": "gojq writes object keys in sorted order; compact bytes differ, JSON values match"
    },
    {
      "id": "users-broad-25k-identity",
      "tool": "gojq",
      "why": "gojq writes object keys in sorted order; compact bytes differ, JSON values match"
    },
    {
      "id": "users-broad-50k-identity",
      "tool": "gojq",
      "why": "gojq writes object keys in sorted order; compact bytes differ, JSON values match"
    },
    {
      "id": "users-broad-100k-identity",
      "tool": "gojq",
      "why": "gojq writes object keys in sorted order; compact bytes differ, JSON values match"
    },
    {
      "id": "users-broad-200k-identity",
      "tool": "gojq",
      "why": "gojq writes object keys in sorted order; compact bytes differ, JSON values match"
    }
  ],
  "pgo_width": "broad",
  "tools": {
    "jqf": { "compact": ["-c"] },
    "jqf-serial": { "compact": ["-c", "--no-parallel"] },
    "jq": { "compact": ["-c"] },
    "jaq": { "compact": ["-c"] },
    "gojq": { "compact": ["-c"] },
    "yq": { "compact": ["-p=json", "-o=json", "-I=0"] },
    "dasel": {
      "compact": ["query", "-o", "json", "--compact", "--config", "/dev/null"],
      "stdin": true
    },
    "mlr": { "compact": [], "words": true }
  },
  "kinds": {
    "users": {
      "suffix": ".json",
      "panel": ["jqf", "jq", "jaq", "gojq", "yq"],
      "queries": [
        { "id": "first-id", "expr": ".users[0].id", "pgo": true },
        { "id": "slice-length", "expr": ".users[{lo}:{hi}] | length", "yq": ".users.[{lo}:{hi}] | length", "pgo": true },
        { "id": "count", "expr": ".users | length", "pgo": true },
        {
          "id": "filter-active",
          "expr": ".users | map(select(.active == true)) | length",
          "pgo": true
        },
        { "id": "project-names", "expr": ".users | map(.name)" },
        {
          "id": "reduce-score",
          "expr": "reduce .users[] as $u (0; . + $u.score)",
          "panel": ["jqf", "jq", "jaq", "gojq"],
          "pgo": true
        },
        { "id": "ids", "expr": "[.users[].id]", "pgo": true },
        { "id": "sort-last", "expr": ".users | sort_by(.score) | .[-1].id", "pgo": true },
        {
          "id": "any-high",
          "expr": ".users | any(.score > 200)",
          "panel": ["jqf", "jq", "jaq", "gojq"],
          "pgo": true
        },
        {
          "id": "project-pair",
          "expr": ".users | map({{id, score}})",
          "yq": ".users | map({{\"id\": .id, \"score\": .score}})"
        },
        {
          "id": "sum-score",
          "expr": "[.users[].score] | add",
          "panel": ["jqf", "jq", "jaq", "gojq"],
          "pgo": true
        },
        { "id": "unique-scores", "expr": "[.users[].score] | unique | length" },
        { "id": "group-mod", "expr": "[.users | group_by(.score % 10)[] | length]", "pgo": true },
        { "id": "high-score", "expr": ".users | map(select(.score > 100)) | length" },
        { "id": "reverse-id", "expr": ".users | reverse | .[0].id", "pgo": true },
        { "id": "keys-len", "expr": ".users[0] | keys | length" },
        {
          "id": "all-nonneg",
          "expr": ".users | all(.score >= 0)",
          "panel": ["jqf", "jq", "jaq", "gojq"],
          "pgo": true
        },
        { "id": "max-score", "expr": ".users | map(.score) | max" },
        { "id": "nested-dept", "expr": ".users[0].profile.department", "pgo": true },
        { "id": "descent", "expr": "[..] | length", "pgo": true },
        { "id": "identity", "expr": ".", "pgo": true }
      ]
    },
    "ndjson": {
      "suffix": ".ndjson",
      "panel": ["jqf", "jq", "jaq", "gojq"],
      "queries": [
        { "id": "first-id", "expr": ".id", "pgo": true },
        { "id": "score", "expr": ".score" },
        { "id": "select-score", "expr": "select(.score > 100)", "pgo": true },
        { "id": "select-id", "expr": "select(.id == 0)" },
        { "id": "identity", "expr": ".", "pgo": true }
      ]
    },
    "yaml": {
      "suffix": ".yaml",
      "sizes": [100, 1000, 5000, 25000, 50000, 100000],
      "panel": ["jqf", "jaq", "gojq", "yq", "dasel"],
      "jqf_extra": ["--input-format", "yaml"],
      "jaq_extra": ["--from", "yaml"],
      "gojq_extra": ["--yaml-input"],
      "yq_compact": ["-o=json", "-I=0"],
      "dasel_extra": ["-i", "yaml"],
      "queries": [
        { "id": "first-id", "expr": ".users[0].id", "dasel": "users[0].id", "pgo": true },
        { "id": "count", "expr": ".users | length", "dasel": "len(users)", "pgo": true },
        { "id": "ids", "expr": "[.users[].id]", "panel": ["jqf", "jaq", "gojq", "yq"] },
        {
          "id": "nested-dept",
          "expr": ".users[0].profile.department",
          "dasel": "users[0].profile.department",
          "pgo": true
        },
        {
          "id": "descent",
          "expr": "[..] | length",
          "panel": ["jqf", "jaq", "gojq", "yq"],
          "pgo": true
        },
        { "id": "identity", "expr": ".", "dasel": "$this", "pgo": true }
      ]
    },
    "toml": {
      "suffix": ".toml",
      "sizes": [100, 1000, 5000, 25000, 50000, 100000],
      "panel": ["jqf", "jaq", "yq", "dasel"],
      "jqf_extra": ["--input-format", "toml"],
      "jaq_extra": ["--from", "toml"],
      "yq_compact": ["-p=toml", "-o=json", "-I=0"],
      "dasel_extra": ["-i", "toml"],
      "queries": [
        { "id": "first-id", "expr": ".users[0].id", "dasel": "users[0].id", "pgo": true },
        { "id": "count", "expr": ".users | length", "dasel": "len(users)", "pgo": true },
        { "id": "ids", "expr": "[.users[].id]", "panel": ["jqf", "jaq", "yq"] },
        {
          "id": "nested-dept",
          "expr": ".users[0].profile.department",
          "dasel": "users[0].profile.department",
          "pgo": true
        },
        {
          "id": "descent",
          "expr": "[..] | length",
          "panel": ["jqf", "jaq", "yq"],
          "pgo": true
        },
        { "id": "identity", "expr": ".", "dasel": "$this", "pgo": true }
      ]
    },
    "csv": {
      "suffix": ".csv",
      "panel": ["jqf", "yq", "mlr"],
      "jqf_extra": ["-n", "--input-format", "csv", "--input-dialect", "csv.utf8-header@1"],
      "yq_compact": ["-p=csv", "-o=json", "-I=0"],
      "queries": [
        {
          "id": "first-id",
          "expr": "input.id | tonumber",
          "yq": ".[0].id",
          "mlr": "--icsv --onidx head -n 1 then cut -f id",
          "pgo": true
        },
        {
          "id": "count",
          "expr": "reduce inputs as $r (0; . + 1)",
          "yq": "length",
          "mlr": "--icsv --onidx count",
          "pgo": true
        },
        {
          "id": "sum-score",
          "expr": "reduce inputs as $r (0; . + ($r.score | tonumber))",
          "panel": ["jqf", "mlr"],
          "mlr": "--icsv --onidx stats1 -a sum -f score",
          "pgo": true
        },
        {
          "id": "high-count",
          "expr": "reduce inputs as $r (0; . + (if ($r.score | tonumber) > 100 then 1 else 0 end))",
          "yq": "map(select(.score > 100)) | length",
          "mlr": "--icsv --onidx filter '$score > 100' then count"
        }
      ]
    }
  }
}
